{
  "name": "den-of-builders-attendance-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "NODE_ENV=production vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/attendance-hub.test.ts && tsx tests/pending-alert.test.ts && tsx tests/listener-error.test.ts && tsx tests/request-pipeline.test.ts",
    "test:alerts": "tsx tests/pending-alert.test.ts",
    "test:listener": "tsx tests/listener-error.test.ts",
    "test:motion": "tsx tests/motion.test.ts",
    "test:rules": "tsx tests/firestore-rules.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^14.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
