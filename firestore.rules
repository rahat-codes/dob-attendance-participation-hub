rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Security & Identity Helper Functions
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    // Super Admin: Enforces email_verified and Google OAuth provider
    function isSuper() {
      return signedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.firebase.sign_in_provider == 'google.com' &&
             request.auth.token.email.lower() == 'rahatmdmahadihasan@gmail.com';
    }

    function isAdmin() {
      return isSuper() || (
        signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myMemberId() {
      return me().memberId;
    }

    function isActiveMember() {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             me().status == 'active' &&
             me().memberId is string &&
             exists(/databases/$(database)/documents/members/$(me().memberId)) &&
             get(/databases/$(database)/documents/members/$(me().memberId)).data.get('status', 'Active') != 'Inactive';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function sessionOpen(sid) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      let mode = s.get('checkInMode', 'auto');
      let openMins = s.get('openMinutesBefore', 15);
      let graceMins = s.get('graceMinutesAfter', 30);
      return s.status != 'cancelled' && s.status != 'completed' && mode != 'closed' && (
        mode == 'open' ||
        (request.time >= s.startAt - duration.value(openMins, 'm') &&
         request.time <= s.endAt + duration.value(graceMins, 'm'))
      );
    }

    function tokenValid(sid, t) {
      let k = get(/databases/$(database)/documents/sessionTokens/$(sid)).data;
      return t is string &&
             t.size() == 8 &&
             t.matches('^[A-Z0-9]{8}$') && (
               (t == k.token && request.time <= k.rotatedAt + duration.value(75, 's')) ||
               (k.prevToken is string && k.prevToken.size() == 8 && k.prevToken.matches('^[A-Z0-9]{8}$') && t == k.prevToken && request.time <= k.rotatedAt + duration.value(30, 's'))
             );
    }

    function isMatchingMonthKey(sid, monthKey) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      return monthKey is string &&
             monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             s.date is string &&
             s.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             monthKey == s.date.split('-')[0] + '-' + s.date.split('-')[1];
    }

    function isValidCheckInStatus(sid, status) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      let lateMins = s.get('lateAfterMinutes', 10);
      let lateAt = s.startAt + duration.value(lateMins, 'm');
      return (status == 'present' && request.time <= lateAt + duration.value(15, 's')) ||
             (status == 'late' && request.time >= lateAt - duration.value(15, 's'));
    }

    function isValidAvatarUrl(url) {
      return url == null || url == '' || (
        url is string && (
          (url.size() <= 500 && url.matches('^https://.+')) ||
          (url.size() <= 150000 && url.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$'))
        )
      );
    }

    function isMemberOwner(memberId, memberData) {
      return isActiveMember() &&
             myMemberId() == memberId && (
               !('authUid' in memberData) ||
               memberData.authUid == null ||
               memberData.authUid == '' ||
               memberData.authUid == request.auth.uid
             );
    }

    function isValidGitHub(url) {
      return url == null || url == '' || (
        url is string &&
        url.size() <= 100 &&
        url.matches('^https://github\\.com/[a-zA-Z0-9]([a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$')
      );
    }

    function isValidLinkedIn(url) {
      return url == null || url == '' || (
        url is string &&
        url.size() <= 150 &&
        !url.matches('.*\\.\\..*') &&
        url.matches('^https://(www\\.)?linkedin\\.com/in/[a-zA-Z0-9._%-]{3,100}/?$')
      );
    }

    function isValidPortfolio(url) {
      return url == null || url == '' || (
        url is string &&
        url.size() <= 200 &&
        url.matches('^https://[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?)*\\.[a-zA-Z]{2,}(/[^\\s]*)?$') &&
        !url.matches('^https://([^/]+\\.)?localhost(/.*)?$')
      );
    }

    // ==========================================
    // Entity Schema Validators (Group A: Pre-Migration Transition)
    // [Group A1]: Safe to deploy before client code changes
    // [Group A2]: Requires synchronized client release
    // ==========================================

    // [Group A1]: User profile field validators (create validates all fields; update validates changed fields so untouched legacy fields never block unrelated actions)
    function isValidUserFields(data) {
      return (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || isValidAvatarUrl(data.photoURL)) &&
             (!('githubUrl' in data) || isValidGitHub(data.githubUrl)) &&
             (!('linkedinUrl' in data) || isValidLinkedIn(data.linkedinUrl)) &&
             (!('portfolioUrl' in data) || isValidPortfolio(data.portfolioUrl)) &&
             (!('applicantName' in data) || data.applicantName == null || (data.applicantName is string && data.applicantName.size() <= 100)) &&
             (!('applicantHandle' in data) || data.applicantHandle == null || (data.applicantHandle is string && data.applicantHandle.size() <= 50)) &&
             (!('applicantStudentId' in data) || data.applicantStudentId == null || (data.applicantStudentId is string && data.applicantStudentId.size() <= 20)) &&
             (!('applicantTrack' in data) || data.applicantTrack == null || data.applicantTrack == '' || data.applicantTrack in ['Hardware & Robotics', 'Software & Systems', 'AI & Embedded', 'Open Hack & Demo']) &&
             (!('applicantNote' in data) || data.applicantNote == null || (data.applicantNote is string && data.applicantNote.size() <= 300)) &&
             (!('requestedNotes' in data) || data.requestedNotes == null || (data.requestedNotes is string && data.requestedNotes.size() <= 1000)) &&
             (!('showLinksPublicly' in data) || data.showLinksPublicly == null || data.showLinksPublicly is bool) &&
             (!('readAnnouncementIds' in data) || data.readAnnouncementIds == null || (data.readAnnouncementIds is list && data.readAnnouncementIds.size() <= 100)) &&
             (!('notificationPrefs' in data) || data.notificationPrefs == null || data.notificationPrefs is map) &&
             (!('notificationPreferences' in data) || data.notificationPreferences == null || data.notificationPreferences is map) &&
             data.status in ['pending', 'approved_waiting_response', 'active', 'declined', 'suspended'];
    }

    function isValidUserUpdate(newData, oldData) {
      let changed = newData.diff(oldData).affectedKeys();
      return (!changed.hasAny(['email']) || newData.email == null || (newData.email is string && newData.email.size() <= 150)) &&
             (!changed.hasAny(['id']) || (newData.id is string && newData.id.size() > 0 && newData.id.size() <= 128)) &&
             (!changed.hasAny(['displayName']) || newData.displayName == null || (newData.displayName is string && newData.displayName.size() <= 100)) &&
             (!changed.hasAny(['photoURL']) || isValidAvatarUrl(newData.photoURL)) &&
             (!changed.hasAny(['githubUrl']) || isValidGitHub(newData.githubUrl)) &&
             (!changed.hasAny(['linkedinUrl']) || isValidLinkedIn(newData.linkedinUrl)) &&
             (!changed.hasAny(['portfolioUrl']) || isValidPortfolio(newData.portfolioUrl)) &&
             (!changed.hasAny(['applicantName']) || newData.applicantName == null || (newData.applicantName is string && newData.applicantName.size() <= 100)) &&
             (!changed.hasAny(['applicantHandle']) || newData.applicantHandle == null || (newData.applicantHandle is string && newData.applicantHandle.size() <= 50)) &&
             (!changed.hasAny(['applicantStudentId']) || newData.applicantStudentId == null || (newData.applicantStudentId is string && newData.applicantStudentId.size() <= 20)) &&
             (!changed.hasAny(['applicantTrack']) || newData.applicantTrack == null || newData.applicantTrack == '' || newData.applicantTrack in ['Hardware & Robotics', 'Software & Systems', 'AI & Embedded', 'Open Hack & Demo']) &&
             (!changed.hasAny(['applicantNote']) || newData.applicantNote == null || (newData.applicantNote is string && newData.applicantNote.size() <= 300)) &&
             (!changed.hasAny(['requestedNotes']) || newData.requestedNotes == null || (newData.requestedNotes is string && newData.requestedNotes.size() <= 1000)) &&
             (!changed.hasAny(['showLinksPublicly']) || newData.showLinksPublicly == null || newData.showLinksPublicly is bool) &&
             (!changed.hasAny(['readAnnouncementIds']) || newData.readAnnouncementIds == null || (newData.readAnnouncementIds is list && newData.readAnnouncementIds.size() <= 100)) &&
             (!changed.hasAny(['notificationPrefs']) || newData.notificationPrefs == null || newData.notificationPrefs is map) &&
             (!changed.hasAny(['notificationPreferences']) || newData.notificationPreferences == null || newData.notificationPreferences is map) &&
             ((!changed.hasAny(['status']) && !('status' in oldData)) || newData.status in ['pending', 'approved_waiting_response', 'active', 'declined', 'suspended']);
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'status']) &&
             data.keys().hasOnly([
               'id', 'email', 'displayName', 'photoURL', 'status', 'memberId', 'approvedMemberId',
               'requestedNotes', 'readAnnouncementIds', 'notificationPrefs', 'notificationPreferences', 'createdAt', 'updatedAt',
               'approvedAt', 'respondedAt', 'membershipRequestedAt',
               'applicantName', 'applicantHandle', 'applicantStudentId', 'applicantTrack',
               'applicantNote', 'githubUrl', 'linkedinUrl', 'portfolioUrl', 'showLinksPublicly'
             ]) &&
             isValidUserFields(data);
    }

    // [Group A1]: Member Schema: Validates core types, link formats, and bounds without rejecting legacy keys (email, phone, counters)
    // so administrators may update, edit, link, or deactivate existing legacy documents before data migration runs.
    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'handle', 'role', 'tracks', 'joinedDate', 'status']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.handle is string && data.handle.size() > 0 && data.handle.size() <= 50 &&
             data.role in ['Member', 'Project Leader', 'Vice President', 'President', 'Founder', 'Lead', 'Builder', 'Apprentice'] &&
             data.tracks is list && data.tracks.size() > 0 && data.tracks.size() <= 10 &&
             (!('avatarUrl' in data) || isValidAvatarUrl(data.avatarUrl)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('leaderboardOptOut' in data) || data.leaderboardOptOut == null || data.leaderboardOptOut is bool) &&
             (!('showLinksPublicly' in data) || data.showLinksPublicly == null || data.showLinksPublicly is bool) &&
             (!('readAnnouncementIds' in data) || data.readAnnouncementIds == null || (data.readAnnouncementIds is list && data.readAnnouncementIds.size() <= 100)) &&
             (!('githubUrl' in data) || isValidGitHub(data.githubUrl)) &&
             (!('linkedinUrl' in data) || isValidLinkedIn(data.linkedinUrl)) &&
             (!('portfolioUrl' in data) || isValidPortfolio(data.portfolioUrl)) &&
             data.status in ['Active', 'Probationary', 'Inactive'];
    }

    // Legacy-tolerant validator for member self-profile updates (allows pre-migration docs missing id/joinedDate or untouched legacy fields)
    function isValidMemberSelfUpdate(newData, oldData) {
      let changed = newData.diff(oldData).affectedKeys();
      return newData.keys().hasAll(['name', 'handle', 'role', 'tracks', 'status']) &&
             (!('id' in newData) || (newData.id is string && isValidId(newData.id))) &&
             newData.name is string && newData.name.size() > 0 && newData.name.size() <= 100 &&
             newData.handle is string && newData.handle.size() > 0 && newData.handle.size() <= 50 &&
             newData.role is string && newData.role.size() > 0 && newData.role.size() <= 50 &&
             newData.tracks is list && newData.tracks.size() > 0 && newData.tracks.size() <= 10 &&
             (!changed.hasAny(['avatarUrl']) || !('avatarUrl' in newData) || isValidAvatarUrl(newData.avatarUrl)) &&
             (!changed.hasAny(['bio']) || !('bio' in newData) || newData.bio == null || (newData.bio is string && newData.bio.size() <= 500)) &&
             (!changed.hasAny(['leaderboardOptOut']) || !('leaderboardOptOut' in newData) || newData.leaderboardOptOut == null || newData.leaderboardOptOut is bool) &&
             (!changed.hasAny(['showLinksPublicly']) || !('showLinksPublicly' in newData) || newData.showLinksPublicly == null || newData.showLinksPublicly is bool) &&
             (!changed.hasAny(['readAnnouncementIds']) || !('readAnnouncementIds' in newData) || newData.readAnnouncementIds == null || (newData.readAnnouncementIds is list && newData.readAnnouncementIds.size() <= 100)) &&
             (!changed.hasAny(['githubUrl']) || !('githubUrl' in newData) || isValidGitHub(newData.githubUrl)) &&
             (!changed.hasAny(['linkedinUrl']) || !('linkedinUrl' in newData) || isValidLinkedIn(newData.linkedinUrl)) &&
             (!changed.hasAny(['portfolioUrl']) || !('portfolioUrl' in newData) || isValidPortfolio(newData.portfolioUrl)) &&
             (!changed.hasAny(['studentId']) || !('studentId' in newData) || newData.studentId == null || (newData.studentId is string && newData.studentId.size() <= 30)) &&
             (!changed.hasAny(['university']) || !('university' in newData) || newData.university == null || (newData.university is string && newData.university.size() <= 120)) &&
             (!changed.hasAny(['profileCompleted']) || !('profileCompleted' in newData) || newData.profileCompleted is bool) &&
             (!changed.hasAny(['profileCompletedAt']) || !('profileCompletedAt' in newData) || (newData.profileCompletedAt is string && newData.profileCompletedAt.size() <= 50)) &&
             (!changed.hasAny(['updatedAt']) || !('updatedAt' in newData) || (newData.updatedAt is string && newData.updatedAt.size() <= 50)) &&
             newData.status in ['Active', 'Probationary', 'Inactive'];
    }

    // [Group A1]: Full Session Validator for new sessions and full updates
    function isValidSessionFull(data) {
      return data.keys().hasAll(['id', 'title', 'track', 'date', 'status', 'location', 'host', 'startAt', 'endAt', 'timezone', 'checkInMode', 'openMinutesBefore', 'graceMinutesAfter', 'lateAfterMinutes', 'points']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.track in ['Hardware & Robotics', 'Software & Systems', 'AI & Embedded', 'Open Hack & Demo'] &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status in ['scheduled', 'completed', 'cancelled', 'active', 'upcoming'] &&
             data.location is string && data.location.size() <= 150 &&
             data.host is string && data.host.size() > 0 && data.host.size() <= 100 &&
             data.startAt is timestamp &&
             data.endAt is timestamp &&
             data.endAt > data.startAt &&
             data.timezone is string && data.timezone.size() <= 50 &&
             data.checkInMode in ['auto', 'open', 'closed'] &&
             data.openMinutesBefore is int && data.openMinutesBefore >= 0 && data.openMinutesBefore <= 240 &&
             data.graceMinutesAfter is int && data.graceMinutesAfter >= 0 && data.graceMinutesAfter <= 240 &&
             data.lateAfterMinutes is int && data.lateAfterMinutes >= 0 && data.lateAfterMinutes <= 240 &&
             data.points is int && data.points >= 0 && data.points <= 1000 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20)) &&
             (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20)) &&
             (!('sessionCode' in data) || (data.sessionCode is string && data.sessionCode.size() <= 20)) &&
             (!('maxCapacity' in data) || (data.maxCapacity is int && data.maxCapacity >= 0 && data.maxCapacity <= 5000)) &&
             (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() <= 50));
    }

    // [Group A2]: Notification validator
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'message', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'title', 'message', 'type', 'read', 'dismissed',
               'createdAt', 'sessionId', 'sessionDate', 'sessionLocation', 'sessionTime'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('type' in data) || data.type in ['announcement', 'reminder', 'system', 'meeting_published', 'meeting_reminder_30m', 'meeting_rescheduled', 'meeting_cancelled']) &&
             (!('read' in data) || data.read is bool) &&
             (!('dismissed' in data) || data.dismissed is bool) &&
             (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128)) &&
             (!('sessionDate' in data) || (data.sessionDate is string && data.sessionDate.size() <= 50)) &&
             (!('sessionLocation' in data) || (data.sessionLocation is string && data.sessionLocation.size() <= 150)) &&
             (!('sessionTime' in data) || (data.sessionTime is string && data.sessionTime.size() <= 50));
    }

    // ==========================================
    // Rules Match Blocks
    // ==========================================

    // Users Collection
    // [Group A1]: Email bound to token email on create; email strictly immutable on all updates
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.id == userId &&
                       request.auth.token.email is string &&
                       request.resource.data.email == request.auth.token.email.lower() &&
                       request.resource.data.status == 'pending' &&
                       !('memberId' in request.resource.data) &&
                       isValidUserCreate(request.resource.data);

      allow update: if signedIn() &&
                       (!('email' in resource.data) || request.resource.data.email == resource.data.email) && (
        (isAdmin() && isValidUserUpdate(request.resource.data, resource.data)) ||
        (
          request.auth.uid == userId &&
          isValidUserUpdate(request.resource.data, resource.data) &&
          (!('id' in request.resource.data) || request.resource.data.id == userId) &&
          (
            // Normal profile update / application submission without changing status or memberId
            (
              ((!('status' in resource.data) && (!('status' in request.resource.data) || request.resource.data.status == 'pending')) || (('status' in resource.data) && request.resource.data.status == resource.data.status)) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'id', 'status', 'displayName', 'photoURL', 'requestedNotes', 'membershipRequestedAt',
                'notificationPrefs', 'notificationPreferences', 'readAnnouncementIds', 'updatedAt',
                'applicantName', 'applicantHandle', 'applicantStudentId', 'applicantTrack',
                'applicantNote', 'githubUrl', 'linkedinUrl', 'portfolioUrl', 'showLinksPublicly'
              ])
            ) ||
            // Applicant accepting an approved invitation
            (
              resource.data.status == 'approved_waiting_response' &&
              request.resource.data.status == 'active' &&
              'approvedMemberId' in resource.data &&
              request.resource.data.memberId == resource.data.approvedMemberId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'id', 'status', 'memberId', 'respondedAt', 'updatedAt'
              ])
            ) ||
            // Applicant declining an approved invitation
            (
              resource.data.status == 'approved_waiting_response' &&
              request.resource.data.status == 'declined' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'id', 'status', 'respondedAt', 'updatedAt'
              ])
            ) ||
            // Re-request after being declined or deactivated: declined/deactivated -> pending transition only
            (
              (resource.data.status == 'declined' || (resource.data.status == 'active' && !isActiveMember())) &&
              request.resource.data.status == 'pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'id', 'status', 'displayName', 'requestedNotes', 'membershipRequestedAt', 'updatedAt',
                'applicantName', 'applicantHandle', 'applicantStudentId', 'applicantTrack',
                'applicantNote', 'githubUrl', 'linkedinUrl', 'portfolioUrl', 'showLinksPublicly'
              ])
            )
          )
        )
      );

      allow delete: if isSuper();
    }

    // Admins Collection: Only super admin can grant/revoke
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isSuper() && isValidId(adminUid);
    }

    // Members Collection (Group A Transition Version: Admins can update legacy documents)
    match /members/{memberId} {
      allow read: if isAdmin() || isActiveMember() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedMemberId == memberId
      );

      allow create: if isAdmin() && isValidId(memberId) && isValidMember(request.resource.data);
      allow delete: if isAdmin() && isValidId(memberId);

      allow update: if (isAdmin() && isValidMember(request.resource.data)) || (
        signedIn() &&
        request.auth.uid == request.resource.data.authUid &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved_waiting_response' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedMemberId == memberId &&
        (!('authUid' in resource.data) || resource.data.authUid == null || resource.data.authUid == '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid'])
      ) || (
        isMemberOwner(memberId, resource.data) &&
        isValidMemberSelfUpdate(request.resource.data, resource.data) &&
        (
          (!('id' in resource.data) && (!('id' in request.resource.data) || request.resource.data.id == memberId)) ||
          ('id' in resource.data && request.resource.data.id == resource.data.id)
        ) &&
        (
          (!('authUid' in resource.data) && !('authUid' in request.resource.data)) ||
          request.resource.data.get('authUid', null) == resource.data.get('authUid', null) ||
          (
            (!('authUid' in resource.data) || resource.data.authUid == null || resource.data.authUid == '') &&
            request.resource.data.authUid == request.auth.uid
          )
        ) &&
        request.resource.data.handle == resource.data.handle &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'name', 'avatarUrl', 'bio', 'tracks', 'leaderboardOptOut', 'studentId', 'university',
          'githubUrl', 'linkedinUrl', 'portfolioUrl', 'showLinksPublicly', 'authUid',
          'profileCompleted', 'profileCompletedAt', 'updatedAt'
        ])
      );
    }

    // Member Private Details: isolated PII
    match /memberPrivate/{memberId} {
      allow read, write: if isAdmin() || (
        exists(/databases/$(database)/documents/members/$(memberId)) &&
        isMemberOwner(memberId, get(/databases/$(database)/documents/members/$(memberId)).data)
      );
    }

    // Sessions Collection: split create, update, delete
    // [Group A1]: Full validator on create, legacy-tolerant on update (status/mode/timestamps)
    match /sessions/{sessionId} {
      allow read: if isAdmin() || isActiveMember();
      allow create: if isAdmin() && isValidId(sessionId) && isValidSessionFull(request.resource.data);
      allow update: if isAdmin() && isValidId(sessionId) && (
        isValidSessionFull(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkInMode', 'closedAt', 'updatedAt', 'cancelledAt', 'deletedAt'])
      );
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // Session Tokens: Kiosk rotating tokens (split create, update, delete)
    // [Group A2]: Requires synchronized 8-char prevToken from client kiosk
    match /sessionTokens/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
                              isValidId(sessionId) &&
                              request.resource.data.rotatedAt == request.time &&
                              request.resource.data.token is string &&
                              request.resource.data.token.matches('^[A-Z0-9]{8}$') &&
                              request.resource.data.prevToken is string &&
                              request.resource.data.prevToken.matches('^[A-Z0-9]{8}$') &&
                              request.resource.data.keys().hasOnly(['token', 'prevToken', 'rotatedAt']);
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // Check-Ins Collection: Finding G fix, tolerance, date-bound monthKey, and strict allowlists
    // [Group A2]: Rejection of notes/verifiedBy on self-checkins, verifiedBy authoritative on manual
    match /checkIns/{checkInId} {
      allow read: if isAdmin() || (
        isActiveMember() && (
          resource == null
            ? checkInId.matches('^.*_' + myMemberId() + '$')
            : resource.data.memberId == myMemberId()
        )
      );

      allow create: if (
        // Admin manual door check-in (verifiedBy is authoritative; authUid is not required)
        (
          isAdmin() &&
          checkInId == request.resource.data.sessionId + '_' + request.resource.data.memberId &&
          request.resource.data.id == checkInId &&
          request.resource.data.method == 'manual_entry' &&
          request.resource.data.verifiedBy == request.auth.uid &&
          request.resource.data.checkedInAt == request.time &&
          exists(/databases/$(database)/documents/members/$(request.resource.data.memberId)) &&
          exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)) &&
          isMatchingMonthKey(request.resource.data.sessionId, request.resource.data.monthKey) &&
          request.resource.data.status in ['present', 'late'] &&
          request.resource.data.keys().hasAll([
            'id', 'sessionId', 'memberId', 'method', 'status', 'monthKey', 'checkedInAt', 'verifiedBy'
          ]) &&
          request.resource.data.keys().hasOnly([
            'id', 'sessionId', 'memberId', 'authUid', 'method', 'token',
            'checkedInAt', 'status', 'monthKey', 'notes', 'verifiedBy'
          ])
        ) ||
        // Member self check-in (notes and verifiedBy strictly forbidden)
        (
          isActiveMember() &&
          checkInId == request.resource.data.sessionId + '_' + myMemberId() &&
          request.resource.data.id == checkInId &&
          request.resource.data.memberId == myMemberId() &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.checkedInAt == request.time &&
          request.resource.data.method in ['camera_scan', 'code_input'] &&
          isMatchingMonthKey(request.resource.data.sessionId, request.resource.data.monthKey) &&
          request.resource.data.keys().hasAll([
            'id', 'sessionId', 'memberId', 'authUid', 'method', 'token', 'checkedInAt', 'status', 'monthKey'
          ]) &&
          request.resource.data.keys().hasOnly([
            'id', 'sessionId', 'memberId', 'authUid', 'method', 'token', 'checkedInAt', 'status', 'monthKey'
          ]) &&
          sessionOpen(request.resource.data.sessionId) &&
          tokenValid(request.resource.data.sessionId, request.resource.data.token) &&
          isValidCheckInStatus(request.resource.data.sessionId, request.resource.data.status)
        )
      );

      allow update: if false; // Check-ins are immutable
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAdmin() || isActiveMember();
      allow write: if isAdmin() && isValidId(announcementId);
    }

    // Notifications: Strict ownership, immutable userId, and field whitelist
    // [Group A1]: Owner update requires only read/dismissed bool changes; legacy docs can be marked read
    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (isAdmin() && isValidNotification(request.resource.data)) ||
                       (signedIn() && request.resource.data.userId == request.auth.uid && isValidNotification(request.resource.data));
      allow update: if signedIn() && (
        (isAdmin() && isValidNotification(request.resource.data) && request.resource.data.userId == resource.data.userId) ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed']) &&
          (!('read' in request.resource.data) || request.resource.data.read is bool) &&
          (!('dismissed' in request.resource.data) || request.resource.data.dismissed is bool)
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Public Leaderboard: Public read, admin write & active member display-only self-sync
    match /publicLeaderboard/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(memberId);
      allow delete: if isAdmin() || (isActiveMember() && memberId == myMemberId());
      allow update: if (isAdmin() && isValidId(memberId)) || (
        isActiveMember() &&
        memberId == myMemberId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'name', 'avatar', 'avatarUrl', 'handle', 'lastUpdated',
          'githubUrl', 'linkedinUrl', 'portfolioUrl', 'showLinksPublicly'
        ]) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100)) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100)) &&
        (!('avatar' in request.resource.data) || isValidAvatarUrl(request.resource.data.avatar)) &&
        (!('avatarUrl' in request.resource.data) || isValidAvatarUrl(request.resource.data.avatarUrl)) &&
        (!('githubUrl' in request.resource.data) || isValidGitHub(request.resource.data.githubUrl)) &&
        (!('linkedinUrl' in request.resource.data) || isValidLinkedIn(request.resource.data.linkedinUrl)) &&
        (!('portfolioUrl' in request.resource.data) || isValidPortfolio(request.resource.data.portfolioUrl))
      );
    }

    // Club Settings
    match /settings/{settingId} {
      allow read: if isAdmin() || isActiveMember();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // [Group A2]: Security Audit Logs: Append-only with serverTimestamp and field whitelist
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       request.resource.data.id == logId &&
                       request.resource.data.performedBy == request.auth.uid &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.keys().hasAll([
                         'id', 'action', 'performedBy', 'details', 'timestamp'
                       ]) &&
                       request.resource.data.keys().hasOnly([
                         'id', 'action', 'performedBy', 'performedByEmail',
                         'targetId', 'targetName', 'details', 'timestamp', 'metadata'
                       ]) &&
                       request.resource.data.action is string &&
                       request.resource.data.action.size() > 0 &&
                       request.resource.data.action.size() <= 60 &&
                       request.resource.data.details is string &&
                       request.resource.data.details.size() > 0 &&
                       request.resource.data.details.size() <= 1000 &&
                       (!('performedByEmail' in request.resource.data) || (request.resource.data.performedByEmail is string && request.resource.data.performedByEmail.size() <= 150)) &&
                       (!('targetId' in request.resource.data) || (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128)) &&
                       (!('targetName' in request.resource.data) || (request.resource.data.targetName is string && request.resource.data.targetName.size() <= 150)) &&
                       (!('metadata' in request.resource.data) || request.resource.data.metadata is map);
      allow update, delete: if false;
    }
  }
}
